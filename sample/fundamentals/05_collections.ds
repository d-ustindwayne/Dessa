// A list: <...>, with its index in <...> too. T<> is a list of T.
var[Int<>] numbers = <3, 1, 2>;
print(numbers, numbers.length(), numbers<0>);
numbers.push(9);
numbers.sort();
print(numbers, numbers.first(), numbers.last());
print(numbers.filter((n[Int]) := n > 1).map((n[Int]) := n * 10));
print(numbers.slice(1, 3), numbers.includes(9));

// Lists are values: a copy doesn't change the first one.
var[Int<>] copy = numbers;
copy.push(100);
print(numbers.length(), copy.length());

// A set: T{} holds each value once.
var[Str{}] seen = {"a", "b"};
seen.add("a");
print(seen.length(), seen.includes("b"));

// A map: Map[K, V], in the order things went in.
var[Map[Str, Int]] ages = {"Ann": 30, "Bo": 25};
ages<"Cy"> = 41;
print(ages<"Ann">, ages.has("Dee"), ages.getOr("Dee", 0));
for (var[Str] person in ages) print(person, ages<person>);

// Two lists side by side.
for (var[(Str | Int)<>] pair in zip(<"a", "b">, <1, 2>)) print(pair);
