<!doctype html>
<html>
<head>
<meta charset="utf-8">
<title>Counter</title>
</head>
<body>
<h1>Clicked <span id="count">0</span> times</h1>
<button id="add">Add one</button>

<!-- In a .dhtml page a plain script is Dessa, with webutils ready to use. -->
<script>
var[State:Int] count = new State(0);
count.bindText(must("#count"));
on(must("#add"), "click", "", (e[Event]) := count.update((n[Int]) := n + 1));
</script>
</body>
</html>
