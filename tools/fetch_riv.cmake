# Gets one commit of the riv repository into SOURCE, once (see CMakeLists.txt)
if(EXISTS ${SOURCE}/riv.ds)
    return()
endif()
find_program(GIT git)
if(NOT GIT)
    message(FATAL_ERROR "Building riv needs git, to fetch ${REPOSITORY}. Or give a copy with -DRIV_DIR=<folder>.")
endif()
execute_process(COMMAND ${GIT} clone --quiet ${REPOSITORY} ${SOURCE} RESULT_VARIABLE failed)
if(failed)
    file(REMOVE_RECURSE ${SOURCE})
    message(FATAL_ERROR "Could not fetch ${REPOSITORY}. Or give a copy with -DRIV_DIR=<folder>.")
endif()
execute_process(COMMAND ${GIT} -C ${SOURCE} checkout --quiet ${COMMIT} RESULT_VARIABLE failed)
if(failed)
    file(REMOVE_RECURSE ${SOURCE})
    message(FATAL_ERROR "${REPOSITORY} has no commit ${COMMIT}.")
endif()
