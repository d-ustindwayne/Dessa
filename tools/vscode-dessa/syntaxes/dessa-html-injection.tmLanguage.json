{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "comment": "Highlights Dessa inside HTML: <script type=\"text/dessa\"> (also text/ds, application/dessa, text/x-dessa).",
  "scopeName": "dessa.html.injection",
  "injectionSelector": "L:text.html -comment",
  "patterns": [{ "include": "#dessa-script" }],
  "repository": {
    "dessa-script": {
      "begin": "(<)(script)\\b(?=[^>]*\\btype\\s*=\\s*[\"']?(?:text|application)/(?:dessa|ds|x-dessa)\\b)([^>]*)(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.script.html" },
        "3": { "name": "meta.attribute.html" },
        "4": { "name": "punctuation.definition.tag.end.html" }
      },
      "end": "(</)(script)\\s*(>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.script.html" },
        "3": { "name": "punctuation.definition.tag.end.html" }
      },
      "contentName": "source.dessa.embedded.html",
      "patterns": [{ "include": "source.dessa" }]
    }
  }
}
