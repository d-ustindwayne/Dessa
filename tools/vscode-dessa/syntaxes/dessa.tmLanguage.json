{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Dessa",
  "scopeName": "source.dessa",
  "fileTypes": [
    "ds"
  ],
  "patterns": [
    {
      "include": "#code"
    }
  ],
  "repository": {
    "code": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#triple-template-string"
        },
        {
          "include": "#triple-string"
        },
        {
          "include": "#template-string"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#chars"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#module-ref"
        },
        {
          "include": "#declarations"
        },
        {
          "include": "#type-annotation"
        },
        {
          "include": "#new-expression"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#members"
        },
        {
          "include": "#constants"
        },
        {
          "include": "#calls"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#types"
        },
        {
          "include": "#variables"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.block.documentation.dessa",
          "begin": "/\\*\\*(?!/)",
          "end": "\\*/",
          "patterns": [
            {
              "name": "storage.type.class.doc.dessa",
              "match": "@\\w+"
            }
          ]
        },
        {
          "name": "comment.block.dessa",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.double-slash.dessa",
          "match": "//.*$"
        }
      ]
    },
    "escapes": {
      "name": "constant.character.escape.dessa",
      "match": "\\\\(x[0-9a-fA-F]{2}|[ntr0\\\\\"'{}])"
    },
    "strings": {
      "name": "string.quoted.double.dessa",
      "begin": "\"",
      "end": "\"|$",
      "patterns": [
        {
          "include": "#escapes"
        }
      ]
    },
    "chars": {
      "name": "string.quoted.single.dessa",
      "match": "'(\\\\.|[^'\\\\])'"
    },
    "template-string": {
      "name": "string.interpolated.dessa",
      "begin": "\\$\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.dessa"
        }
      },
      "end": "\"|$",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.dessa"
        }
      },
      "patterns": [
        {
          "include": "#escapes"
        },
        {
          "name": "meta.interpolation.dessa",
          "begin": "\\{",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.begin.dessa"
            }
          },
          "end": "\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.end.dessa"
            }
          },
          "contentName": "source.dessa",
          "patterns": [
            {
              "include": "#code"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "match": "\\b(0x)([0-9a-fA-F]+)\\b",
          "captures": {
            "1": {
              "name": "storage.type.numeric.prefix.hex.dessa"
            },
            "2": {
              "name": "constant.numeric.hex.dessa"
            }
          }
        },
        {
          "match": "\\b(0b)([01]+)\\b",
          "captures": {
            "1": {
              "name": "storage.type.numeric.prefix.binary.dessa"
            },
            "2": {
              "name": "constant.numeric.binary.dessa"
            }
          }
        },
        {
          "match": "\\b(0o)([0-7]+)\\b",
          "captures": {
            "1": {
              "name": "storage.type.numeric.prefix.octal.dessa"
            },
            "2": {
              "name": "constant.numeric.octal.dessa"
            }
          }
        },
        {
          "name": "constant.numeric.decimal.dessa",
          "match": "\\b[0-9]+(\\.[0-9]+)?[fd]?\\b"
        }
      ]
    },
    "module-ref": {
      "patterns": [
        {
          "comment": "$(\"math\", \"utils.strings\"): module and library names",
          "begin": "(\\$)(\\()",
          "beginCaptures": {
            "1": {
              "name": "keyword.other.import.dessa"
            },
            "2": {
              "name": "punctuation.parenthesis.dessa"
            }
          },
          "end": "\\)",
          "endCaptures": {
            "0": {
              "name": "punctuation.parenthesis.dessa"
            }
          },
          "patterns": [
            {
              "match": "(\")([^\"]*)(\")",
              "captures": {
                "1": {
                  "name": "punctuation.definition.string.begin.dessa"
                },
                "2": {
                  "name": "entity.name.namespace.dessa"
                },
                "3": {
                  "name": "punctuation.definition.string.end.dessa"
                }
              }
            },
            {
              "include": "#comments"
            },
            {
              "name": "keyword.control.import.dessa",
              "match": "\\bas\\b"
            },
            {
              "name": "entity.name.namespace.dessa",
              "match": "\\b[A-Za-z_]\\w*\\b"
            }
          ]
        },
        {
          "name": "keyword.control.import.dessa",
          "match": "\b(from|as)\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "comment": "class[Interface] Name(Parent)",
          "match": "\\b(class)\\b(?:\\s*\\[\\s*([A-Za-z_]\\w*)\\s*\\])?\\s+([A-Za-z_]\\w*)(?:\\s*\\(\\s*([A-Za-z_]\\w*)\\s*\\))?",
          "captures": {
            "1": {
              "name": "storage.type.class.dessa"
            },
            "2": {
              "name": "entity.other.inherited-class.dessa"
            },
            "3": {
              "name": "entity.name.type.class.dessa"
            },
            "4": {
              "name": "entity.other.inherited-class.dessa"
            }
          }
        },
        {
          "match": "\\b(interface|enum)\\s+([A-Za-z_]\\w*)",
          "captures": {
            "1": {
              "name": "storage.type.dessa"
            },
            "2": {
              "name": "entity.name.type.dessa"
            }
          }
        },
        {
          "comment": "func[Type] name(",
          "begin": "\\b(func)\\s*(\\[)",
          "beginCaptures": {
            "1": {
              "name": "storage.type.function.dessa"
            },
            "2": {
              "name": "punctuation.definition.type.begin.dessa"
            }
          },
          "end": "(\\])\\s*([A-Za-z_]\\w*)?",
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.type.end.dessa"
            },
            "2": {
              "name": "entity.name.function.dessa"
            }
          },
          "patterns": [
            {
              "include": "#type-expression"
            }
          ]
        },
        {
          "comment": "var[Type] name / const[Type] name",
          "begin": "\\b(var|const)\\s*(\\[)",
          "beginCaptures": {
            "1": {
              "name": "storage.type.dessa"
            },
            "2": {
              "name": "punctuation.definition.type.begin.dessa"
            }
          },
          "end": "(\\])\\s*([A-Za-z_]\\w*)?",
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.type.end.dessa"
            },
            "2": {
              "name": "variable.other.definition.dessa"
            }
          },
          "patterns": [
            {
              "include": "#type-expression"
            }
          ]
        },
        {
          "match": "\\b(init)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "storage.type.function.constructor.dessa"
            }
          }
        }
      ]
    },
    "type-annotation": {
      "comment": "param[Type] and catch(e[Type])",
      "begin": "\\b([a-z_]\\w*)\\s*(\\[)(?=\\s*(Str|Int|Bul|Flt|Dbl|Chr|Emp|Nil|Obj|Func|Map|[A-Z]\\w*)\\b)",
      "beginCaptures": {
        "1": {
          "name": "variable.parameter.dessa"
        },
        "2": {
          "name": "punctuation.definition.type.begin.dessa"
        }
      },
      "end": "\\]",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.type.end.dessa"
        }
      },
      "patterns": [
        {
          "include": "#type-expression"
        }
      ]
    },
    "type-expression": {
      "patterns": [
        {
          "comment": "nested brackets: Func[Int, [Int, Int]], Int[16]",
          "begin": "\\[",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.type.begin.dessa"
            }
          },
          "end": "\\]",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.type.end.dessa"
            }
          },
          "patterns": [
            {
              "include": "#type-expression"
            }
          ]
        },
        {
          "name": "support.type.function.dessa",
          "match": "\\b(Func|Map)\\b"
        },
        {
          "name": "keyword.operator.variadic.dessa",
          "match": "\\*"
        },
        {
          "name": "support.type.primitive.dessa",
          "match": "\\b(Str|Int|Bul|Flt|Dbl|Chr|Emp|Nil|Obj)\\b"
        },
        {
          "name": "entity.name.type.dessa",
          "match": "\\b[A-Za-z_]\\w*\\b"
        },
        {
          "name": "constant.numeric.dessa",
          "match": "\\b(2|8|10|16)\\b"
        },
        {
          "name": "punctuation.definition.collection.dessa",
          "match": "<>|\\{\\}"
        },
        {
          "name": "keyword.operator.union.dessa",
          "match": "\\|"
        },
        {
          "name": "punctuation.separator.comma.dessa",
          "match": ","
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "storage.type.annotation.dessa",
          "match": "@[A-Za-z_]\\w*"
        },
        {
          "name": "keyword.control.dessa",
          "match": "\\b(if|else|switch|case|default|for|in|while|loop|break|continue|return|try|catch|throw|is)\\b"
        },
        {
          "name": "storage.type.dessa",
          "match": "\\b(var|const|func|class|interface|enum|init)\\b"
        },
        {
          "name": "keyword.operator.new.dessa",
          "match": "\\bnew\\b"
        },
        {
          "name": "invalid.deprecated.reserved.dessa",
          "match": "\\bwith\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.dessa",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.dessa",
          "match": "\\bnil\\b"
        },
        {
          "name": "variable.language.this.dessa",
          "match": "\\b(this|super)\\b"
        },
        {
          "name": "constant.other.enum.dessa",
          "match": "\\b[A-Z][A-Z0-9_]+\\b"
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "match": "\\b(print|input|typeof|zip)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "support.function.builtin.dessa"
            }
          }
        },
        {
          "match": "\\b([a-z_]\\w*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.dessa"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.pipe.dessa",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.lambda.dessa",
          "match": ":="
        },
        {
          "name": "keyword.operator.nullish.dessa",
          "match": "\\?\\?|\\?\\.|\\?=|\\?!"
        },
        {
          "name": "keyword.operator.spread.dessa",
          "match": "\\.\\.\\."
        },
        {
          "name": "keyword.operator.comparison.dessa",
          "match": "==|!=|<=|>="
        },
        {
          "name": "keyword.operator.logical.dessa",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.assignment.compound.dessa",
          "match": "\\+=|-=|\\*=|/=|\\^=|%="
        },
        {
          "name": "keyword.operator.increment.dessa",
          "match": "\\+\\+|--"
        },
        {
          "name": "keyword.operator.bitwise.dessa",
          "match": "\\^\\^|<<|>>|&|\\||~"
        },
        {
          "name": "keyword.operator.arithmetic.dessa",
          "match": "\\+|-|\\*|/|%|\\^"
        },
        {
          "name": "keyword.operator.assignment.dessa",
          "match": "="
        },
        {
          "name": "keyword.operator.ternary.dessa",
          "match": "\\?|:"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.dessa",
          "match": "\\b(Str|Int|Bul|Flt|Dbl|Chr|Emp|Nil|Obj)\\b"
        },
        {
          "name": "entity.name.type.dessa",
          "match": "\\b[A-Z][a-z]\\w*\\b"
        }
      ]
    },
    "triple-string": {
      "name": "string.quoted.triple.dessa",
      "begin": "\"\"\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.dessa"
        }
      },
      "end": "\"\"\"",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.dessa"
        }
      },
      "patterns": [
        {
          "include": "#escapes"
        }
      ]
    },
    "triple-template-string": {
      "name": "string.interpolated.triple.dessa",
      "begin": "\\$\"\"\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.dessa"
        }
      },
      "end": "\"\"\"",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.dessa"
        }
      },
      "patterns": [
        {
          "include": "#escapes"
        },
        {
          "name": "meta.interpolation.dessa",
          "begin": "\\{",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.begin.dessa"
            }
          },
          "end": "\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.end.dessa"
            }
          },
          "contentName": "source.dessa",
          "patterns": [
            {
              "include": "#code"
            }
          ]
        }
      ]
    },
    "new-expression": {
      "match": "\\b(new)\\s+([A-Za-z_]\\w*)",
      "captures": {
        "1": {
          "name": "keyword.operator.new.dessa"
        },
        "2": {
          "name": "entity.name.type.class.dessa"
        }
      }
    },
    "members": {
      "patterns": [
        {
          "match": "(?<![.\\d])(\\?\\.|\\.)(?!\\.)\\s*([A-Za-z_]\\w*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "punctuation.accessor.dessa"
            },
            "2": {
              "name": "entity.name.function.member.dessa"
            }
          }
        },
        {
          "match": "(?<![.\\d])(\\?\\.|\\.)(?!\\.)\\s*([A-Z][A-Z0-9_]+)\\b",
          "captures": {
            "1": {
              "name": "punctuation.accessor.dessa"
            },
            "2": {
              "name": "constant.other.enum.dessa"
            }
          }
        },
        {
          "match": "(?<![.\\d])(\\?\\.|\\.)(?!\\.)\\s*([A-Za-z_]\\w*)",
          "captures": {
            "1": {
              "name": "punctuation.accessor.dessa"
            },
            "2": {
              "name": "variable.other.property.dessa"
            }
          }
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.readwrite.dessa",
          "match": "\\b[a-z_]\\w*\\b"
        }
      ]
    }
  }
}
