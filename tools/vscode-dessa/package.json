{
  "name": "dessa",
  "displayName": "Dessa",
  "description": "Dessa language support: highlighting, errors as you type, completion, hover, go to definition and run, for .ds files, .dhtml pages and Dessa scripts inside HTML.",
  "version": "0.3.4",
  "publisher": "d-ustindwayne",
  "author": {
    "name": "d-ustindwayne"
  },
  "license": "Apache-2.0",
  "icon": "icons/dessa-128x128.png",
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "homepage": "https://github.com/d-ustindwayne/Dessa#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/d-ustindwayne/Dessa.git",
    "directory": "tools/vscode-dessa"
  },
  "bugs": {
    "url": "https://github.com/d-ustindwayne/Dessa/issues"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "dessa",
    "dhtml",
    "language",
    "compiler",
    "transpiler",
    "c++",
    "javascript",
    "intellisense",
    "riv"
  ],
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "dessa",
        "aliases": [
          "Dessa",
          "dessa"
        ],
        "extensions": [
          ".ds",
          ".dx",
          ".dz",
          ".dsx",
          ".dxx",
          ".dzx",
          ".dds",
          ".dss",
          ".dm"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/dessa-icon.svg",
          "dark": "./icons/dessa-icon.svg"
        }
      },
      {
        "id": "dessa-html",
        "aliases": [
          "Dessa HTML",
          "dhtml"
        ],
        "extensions": [
          ".dhtml"
        ],
        "configuration": "./dhtml-language-configuration.json",
        "icon": {
          "light": "./icons/dessa-icon.svg",
          "dark": "./icons/dessa-icon.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "dessa",
        "scopeName": "source.dessa",
        "path": "./syntaxes/dessa.tmLanguage.json"
      },
      {
        "language": "dessa-html",
        "scopeName": "text.html.dessa",
        "path": "./syntaxes/dhtml.tmLanguage.json",
        "embeddedLanguages": {
          "source.dessa.embedded.html": "dessa",
          "source.css": "css",
          "source.js": "javascript"
        }
      },
      {
        "scopeName": "dessa.html.injection",
        "path": "./syntaxes/dessa-html-injection.tmLanguage.json",
        "injectTo": [
          "text.html.basic",
          "text.html.derivative",
          "text.html.dessa"
        ],
        "embeddedLanguages": {
          "source.dessa.embedded.html": "dessa"
        }
      },
      {
        "scopeName": "markdown.dessa.codeblock",
        "path": "./syntaxes/dessa-markdown-injection.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.dessa": "dessa"
        }
      }
    ],
    "commands": [
      {
        "command": "dessa.run",
        "title": "Dessa: Run File",
        "icon": "$(play)"
      },
      {
        "command": "dessa.showCpp",
        "title": "Dessa: Show Generated C++"
      },
      {
        "command": "dessa.check",
        "title": "Dessa: Check File"
      },
      {
        "command": "dessa.reloadPage",
        "title": "Dessa: Reload the Running Page"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "dessa.run",
          "when": "resourceLangId == dessa || resourceLangId == dessa-html",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "dessa.run",
        "key": "ctrl+f5",
        "when": "editorLangId == dessa || editorLangId == dessa-html"
      },
      {
        "command": "dessa.reloadPage",
        "key": "ctrl+r",
        "mac": "cmd+r",
        "when": "dessa.pageRunning && editorTextFocus && editorLangId == dessa-html || dessa.pageTerminal && terminalFocus"
      }
    ],
    "configuration": {
      "title": "Dessa",
      "properties": {
        "dessa.compilerPath": {
          "type": "string",
          "default": "dessa",
          "description": "Path to the dessa compiler executable (e.g. C:\\Projects\\Dessa\\build\\dessa.exe). Leave as 'dessa' if it is on your PATH."
        },
        "dessa.checkOnType": {
          "type": "boolean",
          "default": true,
          "description": "Check the file for errors while typing (otherwise only on open and save)."
        },
        "dessa.autoBrackets": {
          "type": "boolean",
          "default": true,
          "description": "Typing helpers: $ at the start of a line adds (); var, const and func get [] and init (in a class) and super (in an init) get (); a space after if, while, for, switch or catch becomes () and after loop an empty { } body; < where a value starts becomes <> (a list); { after an import becomes {  }; !! in a type gets spaces; picking a type in var[...] or a parameter's [...] moves the cursor past the ]; Backspace on an opening bracket also removes the closing one right after it; Enter inside $(\"x\") puts the import list over several lines."
        },
        "dessa.unusedImports": {
          "type": "string",
          "enum": [
            "dim",
            "warning",
            "off"
          ],
          "default": "dim",
          "enumDescriptions": [
            "Show unused imports faded",
            "Show unused imports as warnings (faded too)",
            "Don't mark unused imports"
          ],
          "description": "How to show imports the file never uses (like TypeScript's noUnusedLocals)."
        },
        "dessa.packageFolders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra folders with riv packages for $(\"lib\") imports (besides riv_modules). The Dessa repository's tools/riv/packages is added automatically."
        }
      }
    },
    "configurationDefaults": {
      "[dessa]": {
        "editor.snippetSuggestions": "none",
        "editor.wordBasedSuggestions": "off"
      },
      "emmet.includeLanguages": {
        "dessa-html": "html"
      }
    }
  }
}
