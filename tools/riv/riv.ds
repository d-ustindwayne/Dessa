/***
 * riv -- the Dessa package manager, written in Dessa.
 *
 * Build it once:   cmake --build build --target riv      (-> build/riv.exe)
 *
 * A package is a folder with a riv.pkg file:
 *
 *     name = colors
 *     version = 1.0.0
 *     entry = lib.ds
 *     description = Terminal colours
 *
 *     [dependencies]
 *     textfx = 0.2.0
 *
 * `riv install` puts the packages a project needs into
 * <project>/riv_modules/<name>/, where imports find them:
 *
 *     $("sql");                           // riv_modules/sql/sql.dm (+ its native part)
 *     { red } from $("colors");           // riv_modules/colors/lib.ds
 *
 * ---- Sharing, like a torrent ----
 * There is no package server. Packages travel with the BitTorrent protocol
 * ($("torrent")):
 *
 *   - The index says which packages and versions exist, each with its
 *     torrent. It is a few JSON files: the official one is in the Dessa
 *     repository (tools/riv/index), and your own is ~/.riv/index.
 *   - `riv install` gets a package from your computer if it already has it
 *     (the store ~/.riv/store, or the packages that came with Dessa), or else
 *     from the people sharing it (`riv seed`), found through public trackers
 *     and on your local network. When no one shares it, the files come from
 *     the torrent's web seed (the package folder on GitHub). Every piece is
 *     checked with SHA-1.
 *   - `riv seed` shares everything you have.
 */

{ readFile, writeFile, fileExists, isDir, listDir, makeDir, deleteAll, cwd, getEnv, run } from $("os");
{ args, exit, platform } from $("sys");
{ Json, parseJson, stringify, jsonObject, jsonStr, jsonNum } from $("json");
{ get as httpGet, Response } from $("request");
{ makeTorrent, Torrent, download, folderMatches, infoHashOf, DEFAULT_TRACKERS, _seed } from $("torrent");
{ toBase64 } from $("dcrypto");

const[Str] MANIFEST = "riv.pkg";
const[Str] MODULES = "riv_modules";
const[Str] OFFICIAL_REPO = "d-ustindwayne/Dessa";
const[Str] OFFICIAL_INDEX = "https://raw.githubusercontent.com/d-ustindwayne/Dessa/main/tools/riv/index";
const[Str] OFFICIAL_WEBSEED = "https://raw.githubusercontent.com/d-ustindwayne/Dessa/main/tools/riv/packages/";
const[Int] DEFAULT_PORT = 6881;

// ============================================================
// Errors
// ============================================================

class RivError {
    var[Str] message = "";
    init(message[Str]) {
        this.message = message;
    }
}

// ============================================================
// riv.pkg
// ============================================================

class Manifest {
    var[Str] name = "";
    var[Str] version = "0.1.0";
    var[Str] entry = "main.ds";
    var[Str] description = "";
    var[Map[Str, Str]] dependencies = {:};

    func[Str] toText() {
        var[Str] text = $"name = {this.name}\nversion = {this.version}\nentry = {this.entry}\n";
        if (!this.description.isEmpty()) {
            text += $"description = {this.description}\n";
        }
        text += "\n[dependencies]\n";
        for (var[Str] dep in this.dependencies) {
            text += $"{dep} = {this.dependencies<dep>}\n";
        }
        return text;
    }

    func[Emp] save(path[Str]="riv.pkg") {
        writeFile(path, this.toText());
    }
}

func[Manifest] parseManifest(text[Str], path[Str]) {
    var[Manifest] manifest = new Manifest();
    var[Str] section = "";
    var[Int] number = 0;
    for (var[Str] raw in text.split("\n")) {
        number++;
        var[Str] line = raw.trim();
        if (line.isEmpty() || line.startsWith("#") || line.startsWith("//")) continue;
        if (line.startsWith("[")) {
            section = line;
            continue;
        }
        var[Int] equals = line.indexOf("=");
        if (equals < 0) {
            throw new RivError($"{path}:{number}: expected `key = value`, got `{line}`");
        }
        var[Str] key = line.substr(0, equals).trim();
        var[Str] value = line.substr(equals + 1, line.length() - equals - 1).trim();
        if (section == "[dependencies]") {
            manifest.dependencies<key> = value;
        } else if (key == "name") {
            manifest.name = value;
        } else if (key == "version") {
            manifest.version = value;
        } else if (key == "entry") {
            manifest.entry = value;
        } else if (key == "description") {
            manifest.description = value;
        }
    }
    if (manifest.name.isEmpty()) {
        throw new RivError($"{path} has no `name = ...`");
    }
    return manifest;
}

func[Manifest] readManifest(path[Str]="riv.pkg") {
    if (!fileExists(path)) {
        throw new RivError($"No {path} here. Run `riv init` to create one.");
    }
    return parseManifest(readFile(path), path);
}

// ============================================================
// Versions:  1.2.10 > 1.2.9
// ============================================================

func[Int<>] versionParts(version[Str]) {
    var[Int<>] parts = [];
    try {
        for (var[Str] part in version.split(".")) {
            parts.push(part.toInt());
        }
    } catch (e[Str]) {
        throw new RivError($"'{version}' is not a version like 1.0.0");
    }
    return parts;
}

// true if version a is newer than version b
func[Bul] newer(a[Str], b[Str]) {
    var[Int<>] x = versionParts(a);
    var[Int<>] y = versionParts(b);
    for (var[Int] i = 0; i < x.length() && i < y.length(); i++) {
        if (x<i> != y<i>) return x<i> > y<i>;
    }
    return x.length() > y.length();
}

func[Str<>] sortVersions(versions[Str<>]) {
    var[Str<>] sorted = [];
    for (var[Str] v in versions) {
        var[Int] at = 0;
        while (at < sorted.length() && newer(v, sorted<at>)) at++;
        sorted.insert(at, v);
    }
    return sorted;
}

// ============================================================
// Files and folders
// ============================================================

// The files of a package folder (relative paths), skipping riv_modules and hidden files.
func[Str<>] packageFiles(root[Str], prefix[Str]="") {
    var[Str<>] files = [];
    var[Str] folder = prefix.isEmpty() ? root : $"{root}/{prefix}";
    for (var[Str] name in listDir(folder)) {
        if (name == MODULES || name.startsWith(".")) continue;
        var[Str] relative = prefix.isEmpty() ? name : $"{prefix}/{name}";
        if (isDir($"{root}/{relative}")) {
            for (var[Str] inner in packageFiles(root, relative)) files.push(inner);
        } else {
            files.push(relative);
        }
    }
    return files;
}

// The last part of a path: C:\work\bank -> bank
func[Str] baseName(path[Str]) {
    var[Str<>] parts = path.replaceAll("\\", "/").split("/");
    return parts<parts.length() - 1>;
}

// The folder part of a relative path: sqlite/sqlite3.c -> sqlite ("" if none)
func[Str] folderOf(path[Str]) {
    var[Str<>] parts = path.split("/");
    if (parts.length() < 2) return "";
    return parts.slice(0, parts.length() - 1).join("/");
}

func[Emp] copyFolder(source[Str], target[Str]) {
    deleteAll(target);
    makeDir(target);
    for (var[Str] path in packageFiles(source)) {
        var[Str] folder = folderOf(path);
        if (!folder.isEmpty()) makeDir($"{target}/{folder}");
        writeFile($"{target}/{path}", readFile($"{source}/{path}"));
    }
}

// ~/.riv (or $RIV_HOME): the store, your index and settings
func[Str] rivHome() {
    var[Str] home = getEnv("RIV_HOME") ?? ((getEnv("USERPROFILE") ?? getEnv("HOME") ?? ".") + "/.riv");
    makeDir(home);
    return home;
}

func[Str] localIndex() {
    var[Str] folder = rivHome() + "/index";
    makeDir(folder);
    return folder;
}

func[Str] storeFolder(name[Str], version[Str]) {
    return $"{rivHome()}/store/{name}/{version}";
}

func[Str] storeTorrent(name[Str], version[Str]) {
    return $"{rivHome()}/store/{name}/{version}.torrent";
}

// "a;b" (Windows) or "a:b" -- the folders in a PATH-like variable
func[Str<>] pathList(value[Str]) {
    var[Str] separator = platform() == "windows" ? ";" : ":";
    return value.split(separator).filter((p[Str]) := !p.trim().isEmpty());
}

// The folders holding the packages that came with Dessa (`riv bundled`), and DESSA_PACKAGES
func[Str<>] bundledFolders() {
    var[Str<>] folders = [];
    var[Str] saved = rivHome() + "/bundled.txt";
    if (fileExists(saved)) {
        for (var[Str] line in readFile(saved).split("\n")) {
            if (!line.trim().isEmpty() && isDir(line.trim())) folders.push(line.trim());
        }
    }
    var[Str | Nil] extra = getEnv("DESSA_PACKAGES");
    if (extra != nil) {
        for (var[Str] f in pathList(extra)) {
            if (isDir(f) && !folders.includes(f)) folders.push(f);
        }
    }
    return folders;
}

// ============================================================
// The index: which packages exist, each version with its torrent
// ============================================================
//
//   <location>/index.json     {"packages": {"sql": {"description": "...", "versions": ["1.0.0"]}}}
//   <location>/<name>.json    {"name": "sql", "description": "...",
//                              "versions": {"1.0.0": {"infohash", "torrent", "manifest", "files", "bytes"}}}
//
// A location is a folder or a web address. $RIV_INDEX lists them (separated
// like PATH); by default your own index (~/.riv/index), then the official one.

func[Str<>] indexLocations() {
    var[Str | Nil] custom = getEnv("RIV_INDEX");
    if (custom != nil) return pathList(custom);
    return [localIndex(), OFFICIAL_INDEX];
}

var[Map[Str, Json | Nil]] indexCache = {:};

// One file of an index location, or nil if it isn't there
func[Json | Nil] readIndexFile(location[Str], file[Str]) {
    var[Str] key = $"{location}/{file}";
    if (indexCache.has(key)) return indexCache<key>;
    var[Json | Nil] found = nil;
    try {
        if (location.startsWith("http://") || location.startsWith("https://")) {
            var[Response] response = httpGet($"{location}/{file}", {:}, 20);
            if (response.ok) found = parseJson(response.text);
        } else if (fileExists($"{location}/{file}")) {
            found = parseJson(readFile($"{location}/{file}"));
        }
    } catch (e[Str]) {
        found = nil;   // offline, or a damaged file: try the other locations
    }
    indexCache<key> = found;
    return found;
}

class PackageInfo {
    var[Str] name = "";
    var[Str] description = "";
    var[Map[Str, Json]] versions = {:};   // version -> entry (the first location that has it wins)

    func[Str<>] sortedVersions() { return sortVersions(this.versions.keys()); }
}

func[PackageInfo] packageInfo(name[Str]) {
    var[PackageInfo] info = new PackageInfo();
    info.name = name;
    for (var[Str] location in indexLocations()) {
        var[Json | Nil] file = readIndexFile(location, $"{name}.json");
        if (file == nil) continue;
        if (info.description.isEmpty() && file.has("description")) info.description = file.get("description").asStr();
        var[Json] versions = file.get("versions");
        for (var[Str] v in versions.keys()) {
            if (!info.versions.has(v)) info.versions<v> = versions.get(v);
        }
    }
    return info;
}

func[Str] latestVersion(name[Str]) {
    var[PackageInfo] info = packageInfo(name);
    if (info.versions.isEmpty()) {
        throw new RivError($"There is no package '{name}'. Try `riv search`.");
    }
    return info.sortedVersions().last();
}

// An index entry for a package folder
func[Json] entryFor(folder[Str], manifest[Manifest], webseeds[Str<>]) {
    var[Torrent] t = makeTorrent(folder, manifest.name, DEFAULT_TRACKERS, webseeds);
    var[Json] entry = jsonObject();
    entry.set("infohash", jsonStr(t.infoHash));
    entry.set("torrent", jsonStr(t.data));
    entry.set("manifest", jsonStr(manifest.toText()));
    entry.set("files", jsonNum(t.files));
    entry.set("bytes", jsonNum(t.bytes));
    return entry;
}

// Adds a version to an index folder (<name>.json and index.json)
func[Emp] addToIndex(location[Str], manifest[Manifest], entry[Json]) {
    makeDir(location);
    var[Str] path = $"{location}/{manifest.name}.json";
    var[Json] file = fileExists(path) ? parseJson(readFile(path)) : jsonObject();
    file.set("name", jsonStr(manifest.name));
    file.set("description", jsonStr(manifest.description));
    if (!file.has("versions")) file.set("versions", jsonObject());
    file.get("versions").set(manifest.version, entry);
    writeFile(path, stringify(file, 2) + "\n");
    updateListing(location, manifest.name, manifest.description, file.get("versions").keys());
}

func[Emp] updateListing(location[Str], name[Str], description[Str], versions[Str<>]) {
    var[Str] path = $"{location}/index.json";
    var[Json] all = fileExists(path) ? parseJson(readFile(path)) : jsonObject();
    if (!all.has("packages")) all.set("packages", jsonObject());
    var[Json] item = jsonObject();
    item.set("description", jsonStr(description));
    var[Json] list = parseJson("[]");
    for (var[Str] v in sortVersions(versions)) list.push(jsonStr(v));
    item.set("versions", list);
    all.get("packages").set(name, item);
    // Sorted by name, so the file changes little from one publish to the next
    var[Json] sorted = jsonObject();
    var[Str<>] names = all.get("packages").keys();
    names.sort((a[Str], b[Str]) := a.compare(b));
    for (var[Str] n in names) sorted.set(n, all.get("packages").get(n));
    all.set("packages", sorted);
    writeFile(path, stringify(all, 2) + "\n");
}

// ============================================================
// Downloading options ($RIV_PEERS, $RIV_TRACKERS=0, $RIV_LAN=0, $RIV_WEBSEED=0, $RIV_TIMEOUT)
// ============================================================

func[Str<>] givenPeers() {
    var[Str | Nil] peers = getEnv("RIV_PEERS");
    if (peers == nil) return [];
    return peers.split(",").map((p[Str]) := p.trim()).filter((p[Str]) := !p.isEmpty());
}

func[Str<>] torrentOptions() {
    var[Str<>] options = [];
    options.push("trackers=" + (getEnv("RIV_TRACKERS") ?? "1"));
    options.push("lan=" + (getEnv("RIV_LAN") ?? "1"));
    options.push("webseed=" + (getEnv("RIV_WEBSEED") ?? "1"));
    options.push("timeout=" + (getEnv("RIV_TIMEOUT") ?? "60"));
    return options;
}

// ============================================================
// Installing
// ============================================================

// Installs packages and everything they depend on into riv_modules/.
class Installer {
    var[Map[Str, Str]] installed = {:};   // name -> version

    func[Emp] install(name[Str], version[Str]) {
        if (this.installed.has(name)) {
            if (this.installed<name> != version) {
                print($"  ! {name}@{version} also wanted; keeping {name}@{this.installed<name>}");
            }
            return;
        }
        // Already there (same version): nothing to do
        var[Str] target = $"{MODULES}/{name}";
        if (fileExists($"{target}/{MANIFEST}")) {
            var[Manifest] here = readManifest($"{target}/{MANIFEST}");
            if (here.version == version) {
                this.installed<name> = version;
                print($"  = {name}@{version} (already installed)");
                for (var[Str] dep in here.dependencies) this.install(dep, here.dependencies<dep>);
                return;
            }
        }
        var[PackageInfo] info = packageInfo(name);
        if (!info.versions.has(version)) {
            var[Str] hint = info.versions.isEmpty() ? "there is no such package" : $"available: {info.sortedVersions().join(", ")}";
            throw new RivError($"{name}@{version} not found ({hint})");
        }
        var[Json] entry = info.versions<version>;
        var[Str] torrent = entry.get("torrent").asStr();
        var[Str] source = this.localCopy(name, version, torrent);
        var[Str] how = "";
        if (source.isEmpty()) {
            source = storeFolder(name, version);
            deleteAll(source);
            makeDir(source);
            print($"  ~ {name}@{version}: looking for people sharing it...");
            how = download(torrent, source, givenPeers(), torrentOptions());
            writeFile(storeTorrent(name, version), torrent);
        } else {
            how = source.startsWith(rivHome()) ? "from your store" : "from the packages that came with Dessa";
        }
        copyFolder(source, target);
        this.installed<name> = version;
        print($"  + {name}@{version}: {how}");

        var[Manifest] manifest = parseManifest(entry.get("manifest").asStr(), $"{name}/{MANIFEST}");
        for (var[Str] dep in manifest.dependencies) this.install(dep, manifest.dependencies<dep>);
    }

    // A folder on this computer that holds exactly this version, or ""
    func[Str] localCopy(name[Str], version[Str], torrent[Str]) {
        var[Str] stored = storeFolder(name, version);
        if (isDir(stored) && folderMatches(stored, torrent)) return stored;
        for (var[Str] folder in bundledFolders()) {
            var[Str] candidate = $"{folder}/{name}";
            if (fileExists($"{candidate}/{MANIFEST}") && readManifest($"{candidate}/{MANIFEST}").version == version &&
                folderMatches(candidate, torrent)) {
                return candidate;
            }
        }
        return "";
    }
}

// ============================================================
// Publishing
// ============================================================

// Puts a package folder in your store and your index, ready to share.
func[Emp] publish(folder[Str], webseeds[Str<>], pullRequest[Bul]) {
    var[Manifest] manifest = readManifest($"{folder}/{MANIFEST}");
    versionParts(manifest.version); // must be a valid version
    var[Json] entry = entryFor(folder, manifest, webseeds);
    var[Str] hash = entry.get("infohash").asStr();

    var[PackageInfo] info = packageInfo(manifest.name);
    if (info.versions.has(manifest.version) && info.versions<manifest.version>.get("infohash").asStr() != hash) {
        throw new RivError($"{manifest.name}@{manifest.version} already exists with other files; raise the version in {MANIFEST}");
    }
    copyFolder(folder, storeFolder(manifest.name, manifest.version));
    writeFile(storeTorrent(manifest.name, manifest.version), entry.get("torrent").asStr());
    addToIndex(localIndex(), manifest, entry);
    print($"Published {manifest.name}@{manifest.version} ({entry.get("files").asInt()} file(s), {entry.get("bytes").asInt()} bytes)");
    print($"  infohash {hash}");
    if (pullRequest) {
        openPullRequest(manifest, entry);
    } else {
        print("It is in your index now. To share it:");
        print("  riv seed                      share it from this computer (keep it running)");
        print("  riv publish --pr              ask for it to be added to the official index (needs the GitHub CLI, gh)");
    }
}

// The output of a command (trimmed)
func[Str] capture(command[Str]) {
    var[Str] file = rivHome() + "/command-output.txt";
    deleteAll(file);
    run($"{command} > \"{file}\" 2>&1");
    return fileExists(file) ? readFile(file).trim() : "";
}

// Opens a pull request adding the package to the official index (tools/riv/index)
func[Emp] openPullRequest(manifest[Manifest], entry[Json]) {
    var[Str] login = capture("gh api user --jq .login");
    if (login.isEmpty() || login.includes(" ")) {
        throw new RivError("`riv publish --pr` needs the GitHub CLI: install it, then run `gh auth login`");
    }
    var[Str] repo = OFFICIAL_REPO;
    if (login + "/Dessa" != OFFICIAL_REPO) {
        capture($"gh repo fork {OFFICIAL_REPO} --clone=false");
        repo = login + "/Dessa";
    }
    var[Str] base = capture($"gh api repos/{OFFICIAL_REPO}/git/ref/heads/main --jq .object.sha");
    var[Str] branch = $"riv-{manifest.name}-{manifest.version}";
    capture($"gh api repos/{repo}/git/refs -f ref=refs/heads/{branch} -f sha={base}");

    // The official files with this version added
    var[Str] work = rivHome() + "/pr";
    deleteAll(work);
    makeDir(work);
    var[Json | Nil] official = readIndexFile(OFFICIAL_INDEX, $"{manifest.name}.json");
    if (official != nil) writeFile($"{work}/{manifest.name}.json", stringify(official, 2));
    var[Json | Nil] listing = readIndexFile(OFFICIAL_INDEX, "index.json");
    if (listing != nil) writeFile($"{work}/index.json", stringify(listing, 2));
    addToIndex(work, manifest, entry);

    for (var[Str] file in [$"{manifest.name}.json", "index.json"]) {
        var[Str] path = $"tools/riv/index/{file}";
        writeFile($"{work}/{file}.b64", toBase64(readFile($"{work}/{file}")));
        var[Str] sha = capture($"gh api \"repos/{repo}/contents/{path}?ref={branch}\" --jq .sha");
        var[Str] update = sha.length() == 40 ? $" -f sha={sha}" : "";
        var[Str] result = capture($"gh api -X PUT repos/{repo}/contents/{path} -f \"message=riv: {manifest.name}@{manifest.version}\" -F content=@{work}/{file}.b64 -f branch={branch}{update}");
        if (!result.includes("\"content\"")) throw new RivError($"GitHub refused {path}: {result}");
    }
    var[Str] head = repo == OFFICIAL_REPO ? branch : $"{login}:{branch}";
    var[Str] url = capture($"gh pr create --repo {OFFICIAL_REPO} --head {head} --title \"riv: publish {manifest.name}@{manifest.version}\" --body \"Adds {manifest.name}@{manifest.version} to the riv index (infohash {entry.get("infohash").asStr()}).\"");
    print($"Pull request: {url}");
    print("Keep `riv seed` running so people can download it.");
}

// ============================================================
// Commands
// ============================================================

func[Emp] cmdInit(name[Str]) {
    if (fileExists(MANIFEST)) {
        throw new RivError($"{MANIFEST} already exists here");
    }
    var[Manifest] manifest = new Manifest();
    manifest.name = name.isEmpty() ? baseName(cwd()) : name;
    manifest.save();
    if (!fileExists(manifest.entry)) {
        writeFile(manifest.entry, $"print(\"Hello from {manifest.name}!\");\n");
    }
    print($"Created {MANIFEST} for '{manifest.name}' (entry: {manifest.entry})");
}

func[Emp] cmdInstall() {
    var[Manifest] manifest = readManifest();
    if (manifest.dependencies.isEmpty()) {
        print("No dependencies to install.");
        return;
    }
    print($"Installing dependencies of {manifest.name}:");
    var[Installer] installer = new Installer();
    for (var[Str] dep in manifest.dependencies) {
        installer.install(dep, manifest.dependencies<dep>);
    }
    print($"Done: {installer.installed.length()} package(s) in {MODULES}/");
}

// riv add colors   /   riv add colors@1.0.0
func[Emp] cmdAdd(spec[Str]) {
    var[Manifest] manifest = readManifest();
    var[Str<>] parts = spec.split("@");
    var[Str] name = parts<0>;
    var[Str] version = parts.length() > 1 ? parts<1> : latestVersion(name);
    manifest.dependencies<name> = version;
    manifest.save();
    print($"Added {name}@{version} to {MANIFEST}");
    cmdInstall();
}

func[Emp] cmdRemove(name[Str]) {
    var[Manifest] manifest = readManifest();
    if (!manifest.dependencies.remove(name)) {
        throw new RivError($"'{name}' is not a dependency of {manifest.name}");
    }
    manifest.save();
    deleteAll($"{MODULES}/{name}");
    print($"Removed {name}");
}

func[Emp] cmdList() {
    var[Manifest] manifest = readManifest();
    print($"{manifest.name}@{manifest.version}");
    if (manifest.dependencies.isEmpty()) {
        print("  (no dependencies)");
    }
    for (var[Str] dep in manifest.dependencies) {
        var[Str] state = isDir($"{MODULES}/{dep}") ? "installed" : "not installed -- run `riv install`";
        print($"  {dep}@{manifest.dependencies<dep>}  ({state})");
    }
}

func[Emp] cmdSearch(text[Str]) {
    var[Map[Str, Str]] described = {:};
    var[Map[Str, Str<>]] versions = {:};
    for (var[Str] location in indexLocations()) {
        var[Json | Nil] listing = readIndexFile(location, "index.json");
        if (listing == nil || !listing.has("packages")) continue;
        var[Json] packages = listing.get("packages");
        for (var[Str] name in packages.keys()) {
            if (!name.lower().includes(text.lower())) continue;
            var[Json] item = packages.get(name);
            if (!described.has(name)) described<name> = item.has("description") ? item.get("description").asStr() : "";
            var[Str<>] known = versions.getOr(name, []);
            for (var[Int] i = 0; i < item.get("versions").length(); i++) {
                var[Str] v = item.get("versions").at(i).asStr();
                if (!known.includes(v)) known.push(v);
            }
            versions<name> = known;
        }
    }
    var[Str<>] names = described.keys();
    names.sort((a[Str], b[Str]) := a.compare(b));
    for (var[Str] name in names) {
        print($"{name}  [{sortVersions(versions<name>).join(", ")}]  {described<name>}");
    }
    if (names.isEmpty()) print("No packages found (are you online?). Publish one with `riv publish`.");
}

// riv info sql   /   riv info sql@1.0.0
func[Emp] cmdInfo(spec[Str]) {
    var[Str<>] parts = spec.split("@");
    var[PackageInfo] info = packageInfo(parts<0>);
    if (info.versions.isEmpty()) throw new RivError($"There is no package '{parts<0>}'. Try `riv search`.");
    var[Str] version = parts.length() > 1 ? parts<1> : info.sortedVersions().last();
    if (!info.versions.has(version)) throw new RivError($"{info.name}@{version} not found (available: {info.sortedVersions().join(", ")})");
    var[Json] entry = info.versions<version>;
    print($"{info.name}@{version}  {info.description}");
    print($"  versions  {info.sortedVersions().join(", ")}");
    print($"  files     {entry.get("files").asInt()} ({entry.get("bytes").asInt()} bytes)");
    print($"  infohash  {entry.get("infohash").asStr()}");
    var[Str] magnet = $"magnet:?xt=urn:btih:{entry.get("infohash").asStr()}&dn={info.name}";
    for (var[Str] t in DEFAULT_TRACKERS) magnet += "&tr=" + t.replaceAll(":", "%3A").replaceAll("/", "%2F");
    print($"  magnet    {magnet}");
}

// riv publish [folder] [--webseed <url>] [--pr]
func[Emp] cmdPublish(rest[Str<>]) {
    var[Str] folder = ".";
    var[Str<>] webseeds = [];
    var[Bul] pullRequest = false;
    for (var[Int] i = 0; i < rest.length(); i++) {
        if (rest<i> == "--pr") {
            pullRequest = true;
        } else if (rest<i> == "--webseed") {
            if (i + 1 >= rest.length()) throw new RivError("--webseed needs a web address (a folder holding <name>/...)");
            i++;
            webseeds.push(rest<i>);
        } else {
            folder = rest<i>;
        }
    }
    publish(folder, webseeds, pullRequest);
}

// riv seed [--port <n>] [--minutes <n>]
func[Emp] cmdSeed(rest[Str<>]) {
    var[Int] port = DEFAULT_PORT;
    var[Int] seconds = 0;
    for (var[Int] i = 0; i + 1 < rest.length(); i += 2) {
        if (rest<i> == "--port") port = Int(rest<i + 1>);
        else if (rest<i> == "--minutes") seconds = Int(rest<i + 1>) * 60;
    }
    var[Str<>] torrents = [];
    var[Str<>] folders = [];
    var[Str<>] names = [];
    // The store: everything installed or published from here
    var[Str] store = rivHome() + "/store";
    if (isDir(store)) {
        for (var[Str] name in listDir(store)) {
            for (var[Str] file in listDir($"{store}/{name}")) {
                if (!file.endsWith(".torrent")) continue;
                var[Str] version = file.substr(0, file.length() - 8);
                if (!isDir($"{store}/{name}/{version}")) continue;
                torrents.push(readFile($"{store}/{name}/{file}"));
                folders.push($"{store}/{name}/{version}");
                names.push($"{name}@{version}");
            }
        }
    }
    // The packages that came with Dessa, when they match the index
    for (var[Str] root in bundledFolders()) {
        for (var[Str] name in listDir(root)) {
            var[Str] folder = $"{root}/{name}";
            if (!fileExists($"{folder}/{MANIFEST}")) continue;
            var[Manifest] manifest = readManifest($"{folder}/{MANIFEST}");
            var[Str] label = $"{manifest.name}@{manifest.version}";
            if (names.includes(label)) continue;
            var[PackageInfo] info = packageInfo(manifest.name);
            if (!info.versions.has(manifest.version)) continue;
            var[Str] torrent = info.versions<manifest.version>.get("torrent").asStr();
            if (!folderMatches(folder, torrent)) continue;
            torrents.push(torrent);
            folders.push(folder);
            names.push(label);
        }
    }
    if (torrents.isEmpty()) throw new RivError("Nothing to share yet: install or publish a package first.");
    print($"Sharing {names.join(", ")}");
    _seed(torrents, folders, port, torrentOptions(), seconds);
}

// riv bundled <folder>: where the packages that came with Dessa are
func[Emp] cmdBundled(folder[Str]) {
    if (!isDir(folder)) throw new RivError($"no folder '{folder}'");
    var[Str] saved = rivHome() + "/bundled.txt";
    var[Str<>] folders = fileExists(saved) ? readFile(saved).split("\n").map((l[Str]) := l.trim()).filter((l[Str]) := !l.isEmpty()) : [];
    if (!folders.includes(folder)) folders.push(folder);
    writeFile(saved, folders.join("\n") + "\n");
    var[Int] count = listDir(folder).filter((n[Str]) := fileExists($"{folder}/{n}/{MANIFEST}")).length();
    print($"riv will use the {count} package(s) in {folder} without downloading them, and share them with `riv seed`.");
}

// riv index <packages folder> [--out <folder>] [--webseed <url>] [--check]
// (for whoever maintains an index: makes or checks <name>.json for every package)
func[Emp] cmdIndex(rest[Str<>]) {
    if (rest.isEmpty()) throw new RivError("`riv index` needs a folder of packages");
    var[Str] root = rest<0>;
    var[Str] out = localIndex();
    var[Str<>] webseeds = [];
    var[Bul] check = false;
    for (var[Int] i = 1; i < rest.length(); i++) {
        if (rest<i> == "--check") check = true;
        else if (rest<i> == "--out" && i + 1 < rest.length()) { i++; out = rest<i>; }
        else if (rest<i> == "--webseed" && i + 1 < rest.length()) { i++; webseeds.push(rest<i>); }
    }
    var[Int] problems = 0;
    var[Str<>] names = listDir(root);
    for (var[Str] name in names) {
        var[Str] folder = $"{root}/{name}";
        if (!fileExists($"{folder}/{MANIFEST}")) continue;
        var[Manifest] manifest = readManifest($"{folder}/{MANIFEST}");
        var[Str] label = $"{manifest.name}@{manifest.version}";
        if (check) {
            var[Json | Nil] file = fileExists($"{out}/{manifest.name}.json") ? parseJson(readFile($"{out}/{manifest.name}.json")) : nil;
            if (file == nil || !file.get("versions").has(manifest.version)) {
                print($"  MISSING  {label} is not in {out}");
                problems++;
            } else if (!folderMatches(folder, file.get("versions").get(manifest.version).get("torrent").asStr())) {
                print($"  CHANGED  {label}: the files differ from the index (raise the version and run riv index again)");
                problems++;
            } else {
                print($"  ok       {label}");
            }
            continue;
        }
        addToIndex(out, manifest, entryFor(folder, manifest, webseeds));
        print($"  indexed  {label}");
    }
    if (problems > 0) {
        print($"{problems} package(s) need `riv index {root} --out {out}`");
        exit(1);
    }
}

func[Emp] cmdRun(extra[Str<>]) {
    var[Manifest] manifest = readManifest();
    var[Str] dessa = getEnv("DESSA") ?? "dessa";
    var[Str] command = $"\"{dessa}\" run {manifest.entry}";
    if (!extra.isEmpty()) {
        command += $" -- {extra.join(" ")}";
    }
    exit(run(command));
}

func[Emp] help() {
    print("riv -- the Dessa package manager");
    print();
    print("  riv init [name]           create riv.pkg (and main.ds) in this folder");
    print("  riv add <pkg>[@version]   add a dependency and install it");
    print("  riv remove <pkg>          remove a dependency");
    print("  riv install               install every dependency into riv_modules/");
    print("  riv list                  show this package's dependencies");
    print("  riv search [text]         list the packages in the index");
    print("  riv info <pkg>[@version]  versions, size, infohash and magnet link");
    print("  riv publish [folder]      put a package in your index and store (--webseed <url>, --pr)");
    print("  riv seed                  share your packages with others (--port <n>, --minutes <n>)");
    print("  riv bundled <folder>      use the packages that came with Dessa from that folder");
    print("  riv run [args...]         run this package's entry file");
    print();
    print($"Your store and index: {rivHome()}  (set RIV_HOME to change it)");
    print($"Indexes: {indexLocations().join(", ")}  (RIV_INDEX)");
}

// ============================================================
// Main
// ============================================================

var[Str<>] argv = args();
var[Str] command = argv.isEmpty() ? "help" : argv<0>;
var[Str] argument = argv.length() > 1 ? argv<1> : "";
var[Str<>] rest = argv.length() > 1 ? argv.slice(1, argv.length()) : [];

func[Emp] needArgument(what[Str]) {
    if (argument.isEmpty()) {
        throw new RivError($"`riv {command}` needs {what}");
    }
}

try {
    switch (command) {
        case "init" := { cmdInit(argument); }
        case "install" := { cmdInstall(); }
        case "add" := {
            needArgument("a package name, e.g. riv add sql");
            cmdAdd(argument);
        }
        case "remove" := {
            needArgument("a package name");
            cmdRemove(argument);
        }
        case "list" := { cmdList(); }
        case "search" := { cmdSearch(argument); }
        case "info" := {
            needArgument("a package name");
            cmdInfo(argument);
        }
        case "publish" := { cmdPublish(rest); }
        case "seed" := { cmdSeed(rest); }
        case "bundled" := {
            needArgument("the folder of the bundled packages");
            cmdBundled(argument);
        }
        case "index" := { cmdIndex(rest); }
        case "run" := { cmdRun(rest); }
        case "help" := { help(); }
        default := {
            print($"riv: unknown command '{command}'");
            print();
            help();
            exit(1);
        }
    }
} catch (e[RivError]) {
    print($"riv: {e.message}");
    exit(1);
} catch (e[Str]) {
    print($"riv: {e}");
    exit(1);
}
