// Native part of $("sql"); the API (Database, connect, openSqlite, ...) is in sql.dm
header sql.hpp
source sqlite/sqlite3.c
source sql.cpp
link.windows -lodbc32
link.unix -ldl
link.unix -lpthread

func[Str<>] _odbcDrivers()
func[Int] _odbcOpen(connection[Str])
func[Int] _sqliteOpen(path[Str])
func[Str<>] _query(handle[Int], sql[Str], params[Str<>])
func[Int] _execute(handle[Int], sql[Str], params[Str<>])
func[Emp] _close(handle[Int])

// The native part in C, for C programs and WebAssembly (SQLite only there)
c sql.c
wasm.cflags -DSQLITE_THREADSAFE=0 -DSQLITE_OMIT_LOAD_EXTENSION -D_WASI_EMULATED_MMAN -D_WASI_EMULATED_GETPID -D_WASI_EMULATED_PROCESS_CLOCKS -D_WASI_EMULATED_SIGNAL
wasm.link -lwasi-emulated-mman -lwasi-emulated-getpid -lwasi-emulated-process-clocks -lwasi-emulated-signal
