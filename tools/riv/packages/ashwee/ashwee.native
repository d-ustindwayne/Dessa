// Native part of $(<ashwee>); the API (Window, Button, run, ...) is in ashwee.dm
header ashwee.hpp
source ashwee.cpp
link.windows -lgdi32
link.windows -luser32
link.windows -lcomctl32

func[Int] _window(title[Str], width[Int], height[Int])
func[Int] _control(window[Int], kind[Str], text[Str], x[Int], y[Int], width[Int], height[Int])
func[Emp] _show(window[Int])
func[Emp] _close(window[Int])
func[Emp] _setText(id[Int], text[Str])
func[Str] _getText(id[Int])
func[Emp] _setEnabled(id[Int], enabled[Bul])
func[Emp] _setChecked(id[Int], checked[Bul])
func[Bul] _isChecked(id[Int])
func[Emp] _listAdd(id[Int], item[Str])
func[Emp] _listClear(id[Int])
func[Int] _listSelected(id[Int])
func[Emp] _message(title[Str], text[Str])
func[Str<>] _nextEvent()
