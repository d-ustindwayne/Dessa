// $("sql") with SQLite (an in-memory database)

$("sql") { openSqlite, Database, SqlError }

class Staff {
    var[Int] staffId = 0;
    var[Str] firstName = "";
    var[Dbl] rate = 0;
    var[Bul] active = false;
    var[Str | Nil] note = nil;
}

var[Database] db = openSqlite(":memory:");
print(db);

db.execute("CREATE TABLE products (id INTEGER PRIMARY KEY, name TEXT, price REAL, stock INTEGER, active INTEGER); INSERT INTO products (name, price, stock, active) VALUES ('Mouse', 25.99, 150, 1);");
print(db.execute("INSERT INTO products (name, price, stock, active) VALUES (?, ?, ?, ?)", "Chair", 149.5, 45, true));
db.execute("INSERT INTO products (name, price, stock, active) VALUES (?, ?, ?, ?)", "Café ☕ mug", 8, nil, false);

for (var[Obj] row in db.queryAll("SELECT * FROM products ORDER BY id")) {
    print(row);
}
print(db.queryAll("SELECT name FROM products WHERE price > ? AND active = ?", 20, true).map((r[Obj]) := Str(r.name)));

var[Obj] mug = db.query("SELECT name, stock FROM products WHERE id = ?", 3);
print(mug.name, mug.stock == nil, typeof(mug.name));
print(db.query("SELECT * FROM products WHERE id = ?", 99) == nil);
print(db.execute("UPDATE products SET price = price * 2 WHERE price < ?", 30));
print(db.query("SELECT COUNT(*) AS n, SUM(price) AS total FROM products"));

// Values can't break the SQL: this is just a strange name
db.execute("INSERT INTO products (name) VALUES (?)", "x'); DROP TABLE products; --");
print(db.query("SELECT COUNT(*) AS n FROM products").n);

try {
    db.queryAll("SELECT * FROM missing_table");
} catch (e[SqlError]) {
    print(e.message);
}
// Rows into objects of a class
db.execute("CREATE TABLE staff (staff_id INTEGER, first_name TEXT, rate REAL, active INTEGER, note TEXT, extra TEXT)");
db.execute("INSERT INTO staff VALUES (1, 'Ann', 52.5, 1, NULL, 'x'), (2, 'Bo', 40, 0, 'new', 'y')");
for (var[Staff] person in db.queryAllAs:Staff("SELECT * FROM staff ORDER BY staff_id")) {
    print(person, person.firstName.upper());
}
var[Staff | Nil] bo = db.queryAs:Staff("SELECT * FROM staff WHERE staff_id = ?", 2);
if (bo != nil) print(bo.rate * 2);
print(db.queryAs:Staff("SELECT * FROM staff WHERE staff_id = 99"));
db.queryAllAs:Staff("SELECT * FROM staff").forEach((s[Staff]) := print(s.firstName, s.active));
try {
    db.queryAllAs:Staff("SELECT 'not a number' AS staff_id");
} catch (e[SqlError]) {
    print(e.message);
}
db.close();
try {
    db.query("SELECT 1");
} catch (e[SqlError]) {
    print(e.message);
}
