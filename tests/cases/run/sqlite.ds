// $(<sql>) with SQLite (an in-memory database)

{ openSqlite, Database, SqlError } from $(<sql>);
{ Json } from $(<json>);

var[Database] db = openSqlite(":memory:");
print(db);

db.execute("CREATE TABLE products (id INTEGER PRIMARY KEY, name TEXT, price REAL, stock INTEGER, active INTEGER); INSERT INTO products (name, price, stock, active) VALUES ('Mouse', 25.99, 150, 1);");
print(db.execute("INSERT INTO products (name, price, stock, active) VALUES (?, ?, ?, ?)", "Chair", 149.5, 45, true));
db.execute("INSERT INTO products (name, price, stock, active) VALUES (?, ?, ?, ?)", "Café ☕ mug", 8, nil, false);

for (var[Json] row in db.query("SELECT * FROM products ORDER BY id")) {
    print(row);
}
print(db.query("SELECT name FROM products WHERE price > ? AND active = ?", 20, true).map((r[Json]) := r.get("name").asStr()));

var[Json | Nil] mug = db.queryOne("SELECT name, stock FROM products WHERE id = ?", 3);
if (mug != nil) {
    print(mug.get("name").asStr(), mug.get("stock").isNull());
}
print(db.queryOne("SELECT * FROM products WHERE id = ?", 99) == nil);
print(db.execute("UPDATE products SET price = price * 2 WHERE price < ?", 30));
print(db.queryOne("SELECT COUNT(*) AS n, SUM(price) AS total FROM products"));

// Values can't break the SQL: this is just a strange name
db.execute("INSERT INTO products (name) VALUES (?)", "x'); DROP TABLE products; --");
print(db.queryOne("SELECT COUNT(*) AS n FROM products"));

try {
    db.query("SELECT * FROM missing_table");
} catch (e[SqlError]) {
    print(e.message);
}
db.close();
try {
    db.query("SELECT 1");
} catch (e[SqlError]) {
    print(e.message);
}
