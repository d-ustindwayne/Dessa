// Lists: <1, 2>, <> (empty), nested <<1>, <2>>; a comparison inside needs brackets
var[Int<>] a = <1, 2, 3>;
var[Int<><>] b = <<1, 2>, <3, 4>>;
var[Int<>] c = <4, 5, 6>;
var[Int<><>] d = <<1, 2>, <3>>;
var[Int<>] e = <>;
var[Bul<>] f = <(1 > 2), 3 >= 3, (1 < 2)>;
var[Int<><>] g = <<1>, <2, 3>,>;
print(a, b, c, d, e, f, g, d<0><1>, <7, 8><1>, <1, 2>.length());
var[Func[Bul, [Int]]<>] fs = <(x[Int]) := (x > 1)>;
print(fs<0>(5));
var[Int] i = 0;
print(b<b<0><0>><0>, d<c<0> - 4><1>, 8 >> 1, 1 << 3);
var[Map[Str, Int<>]] m = {"a": <1>};
print(m);
var[Lst[Int | Str]] mixed = <1, "two", 3>;
var[Lst[Int]] plain = <4, 5>;
print(mixed, plain.length(), typeof(mixed));
