// User modules: $("dotted.path") { names } and bare $("path")

$("lib.shapes.circle") { Circle, describe as describeCircle, TAU, created, Kind }
$("lib.util");

var[Circle] c = new Circle(2.0);
print(describeCircle(c), c.circumference() > 12.5, TAU > 6);
print(describeCircle(unit()));
print(shout("modules work"));
print(created);
print(Kind.SQUARE);
