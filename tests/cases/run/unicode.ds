// Text counts characters, not bytes

var[Str] word = "café";
var[Str] face = "hi 😀!";
print(word.length(), face.length(), "日本語".length());
print(word<3>, face<3>, face.chars());
print(word.substr(2, 2), face.indexOf("!"), "naïve".indexOf("v"));
print(word.upper(), "ÉCOLE".lower(), "straße".upper());

var[Chr] e = 'é';
var[Chr] smile = '😀';
print(e, smile, e.code(), smile.code(), Chr(233), Chr(128512) == smile);
print(e.isAlpha(), e.isUpper(), 'É'.isUpper(), e.upper(), '9'.isDigit(), ' '.isSpace());

var[Str] built = "";
for (var[Chr] c in "añb") {
    built += c;
    built += '-';
}
print(built, "x" + 'ñ', 'ñ' + "y");

print("a😀b".split(""), Str('😀').length(), Chr("😀") == smile);
var[Map[Chr, Int]] counts = {:};
for (var[Chr] c in "mississippi") {
    counts<c> = counts.getOr(c, 0) + 1;
}
print(counts);

try {
    print(Chr("ab"));
} catch (err[Str]) {
    print(err);
}
