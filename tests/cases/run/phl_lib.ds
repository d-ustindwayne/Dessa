// $("phl") -- PHL, Dessa's data format (tools/riv/packages/phl/phl.dm)

{ parsePhl, toPhl, PhlError } from $("phl");
{ Json, stringify } from $("json");
{ readFile } from $("os");

// The example document from sample/sample.phl
var[Json] doc = parsePhl(readFile("sample/sample.phl"));
print(doc.keys());
print(doc.get("name").asStr(), doc.get("email").asStr());
print(doc.get("product").length(), doc.get("product").at(3).get("ID").asInt(), doc.get("product").at(2).get("Price").asDbl());
print(doc.get("Services").get("Database").get("Port").asInt());
print(doc.get("Services").get("Theme").get("Colors").get("BackgroundColor").asStr());
print(stringify(doc.get("Services"), 2));

// Back to PHL, and parsing that gives the same data
var[Str] text = toPhl(doc);
print(text);
print(parsePhl(text).toStr() == doc.toStr());

// Mistakes are reported with their position
func[Emp] tryParse(source[Str]) {
    try {
        parsePhl(source);
        print("ok");
    } catch (e[PhlError]) {
        print(e.message);
    }
}
tryParse("name: \"a\"\n\"no key\"");
tryParse("t: {A, B} [1, 2; 3;]");
tryParse("x: hello");
tryParse("a: 1\na: 2");
tryParse("obj: [x: 1, y: 2,]   // trailing comma and a comment");
