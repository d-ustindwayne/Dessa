// Imports: user modules and builtin libraries

$("lib.geo.shapes") { Circle, area }
$("lib.geo.shapes") { Circle as C2 }
$("lib.geo.shapes") { Square }                // error: Module does not export 'Square'
$("lib.geo.missing") { thing }                // error: Cannot find module or library 'lib.geo.missing'
$("math") { sqrt, PI }
$("nosuchlib") { foo }                        // error: Cannot find module or library 'nosuchlib'
$(<math>) { cbrt }                            // error: Libraries are imported by name without < >: $("math")
$("lib.geo.shapes", "lib.geo.other");         // error: exported by more than one imported module
$("lib.geo.other") { area as area2 }
{ floor } from $("math");                     // error: Imports are written $("math") { floor } now
$("math" as m)
$("time" as clock)

var[Circle] c = new Circle(2.0);
var[C2] same = c;
var[Dbl] a = area(c);
var[Dbl] root = sqrt(PI);
var[Int] z = area2();
SIDES = 3;                                    // error: Cannot assign to constant 'SIDES'
var[Dbl] r = m.cbrt(8);
var[Dbl] bad = m.nothing(1);                  // error: Module 'm' has no 'nothing'
print(m);                                     // error: 'm' is a module; use one of its names
var[m.Big] big = new m.Big("12");
var[q.Thing] t;                               // error: Unknown module name 'q'
