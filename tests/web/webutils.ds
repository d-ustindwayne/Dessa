// Used by webutils.html (browser test of $(<webutils>)).
{ document, window, Element, Event, alert, prompt, confirm, log, warn, setTimeout, setInterval, clearTimer, fetchText } from $(<webutils>);
{ Json, parseJson } from $(<json>);

func[Element] need(id[Str]) {
    var[Element | Nil] element = document.getElementById(id);
    if (element == nil) throw $"no #{id}";
    return element;
}

print("stored:", window.localStorage.getItem("greeting") ?? "nothing", window.localStorage.getItem("missing") ?? "Nil");

need("ask").addEventListener("click", (e[Event]) := {
    var[Str | Nil] name = prompt("Your name?", "Ann");
    if (name == nil) {
        need("answer").textContent = "cancelled";
        return;
    }
    var[Bul] sure = confirm($"Are you {name}?");
    alert(sure ? $"Hello, {name}!" : "Who are you then?");
    need("answer").textContent = $"{name} / {sure}";
});

// An error inside an event listener is reported, not lost
need("broken").addEventListener("click", (e[Event]) := {
    var[Int<>] empty = [];
    print(empty<3>);
});

var[Int] ticks = 0;
var[Int] id = 0;
id = setInterval(() := {
    ticks++;
    need("timer").textContent = $"tick {ticks}";
    if (ticks == 3) {
        clearTimer(id);
        log("timer stopped after", Str(ticks), "ticks");
    }
}, 20);
setTimeout(() := print("timeout fired"), 10);

var[Json] data = parseJson(fetchText("data.json"));
print("fetched:", data.get("language").asStr(), data.get("version").asDbl());
try {
    fetchText("missing.json");
} catch (e[Str]) {
    print("fetch error:", e);
}
warn("this is a warning");
var[Element] style = need("answer");
style.style.color = "rebeccapurple";
style.classList.add("checked");
print("style:", style.style.color, style.classList.contains("checked"), document.querySelectorAll("button").length());
